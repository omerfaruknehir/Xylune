<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:icon="@drawable/default_icon"
        android:label="Icon Lab"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".DynamicLaunchActivity"
            android:exported="true"
            android:theme="@style/RuntimeSplashTheme" />

        <activity-alias
            android:name=".StockLauncher"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/default_icon"
            android:label="Icon Lab"
            android:targetActivity=".DynamicLaunchActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".PinResultReceiver"
            android:exported="false" />
    </application>
</manifest>
